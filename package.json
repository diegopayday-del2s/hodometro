{
  "name": "hodometro",
  "version": "1.1.0",
  "private": true,
  "description": "Hodômetro de bike: grava o pedal pelo GPS, funciona offline. Web (PWA) e app Android.",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "precisao": "node ferramentas/precisao.mjs",
    "start": "npx --yes http-server -p 8080 -c-1 .",
    "web": "node ferramentas/copiar-web.mjs",
    "android:sync": "npm run web && npx cap sync android",
    "android:abrir": "npm run android:sync && npx cap open android"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.2.26",
    "@capacitor-community/text-to-speech": "6.1.0",
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor/share": "7.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9"
  }
}
